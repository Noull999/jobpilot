  "cv_best_practices": {
    "general": [
      "Máximo 1 página para junior, 2 para senior",
      "Sans-serif font (Calibri, Helvetica, Arial)",
      "Font size 10-12pt",
      "Márgenes 0.5-1 inch",
      "Usa bullets, no párrafos largos",
      "Acción + Resultado (cuantificado)",
      "Reverse chronological order"
    ],
    "sections_order": [
      "Header (nombre, contacto)",
      "Resumen profesional (3-4 líneas)",
      "Experiencia laboral",
      "Educación",
      "Skills técnicas",
      "Certificaciones",
      "Proyectos destacados (opcional)"
    ],
    "action_verbs": [
      "Desarrollé", "Implementé", "Lideré", "Optimicé",
      "Automaticé", "Diseñé", "Contribuí", "Mejorqué",
      "Creé", "Gestioné", "Coordiné", "Resolví"
    ],
    "what_to_avoid": [
      "Foto (salvo networking)",
      "Información personal innecesaria",
      "Errores ortográficos",
      "Nombres de empresas confidenciales",
      "Tecnologías obsoletas",
      "Gaps sin explicación",
      "Genéricos (ej: 'hard worker')"
    ]
  },

  "salary_negotiation": {
    "tips": [
      "Investiga el rango salarial del puesto",
      "Pide lo que mereces basado en datos",
      "No digas número primero",
      "Incluye beneficios (vacaciones, bonos, flexibilidad)",
      "Negocia para el largo plazo",
      "Sé profesional pero firme",
      "Ten 2-3 opciones de beneficios"
    ],
    "phrases": [
      "Basándome en mi experiencia y el mercado, esperaba algo en el rango de X-Y",
      "¿Cuál es el rango presupuestado para este puesto?",
      "Aprecio la oferta, me gustaría conversar sobre X",
      "¿Podríamos explorar opciones de work-from-home o flexibilidad?",
      "¿Hay oportunidad para revisión salarial en los primeros 6 meses?"
    ],
    "red_flags": [
      "Se niegan a discutir salario hasta el final",
      "Oferta significativamente bajo mercado",
      "Sin beneficios claros",
      "Sin crecimiento salarial a futuro",
      "Vaguedad en términos de empleo"
    ]
  },

