  "cover_letter_templates": {
    "professional": {
      "structure": [
        "Saludo formal a la persona responsable",
        "1-2 líneas: por qué te interesa la posición",
        "2-3 líneas: cómo tu experiencia encaja",
        "1-2 líneas: qué aportes específicos haces",
        "1 línea: cierre profesional"
      ],
      "tone": "Formal pero personal",
      "length_words": 200,
      "example_opening": "Estimado/a [nombre],\n\nMe dirijo a usted respecto a la posición de [puesto] en [empresa]..."
    },
    "casual": {
      "structure": [
        "Saludo casual personalizado",
        "Por qué te emociona esta oportunidad",
        "Qué hace único tu perfil",
        "Pregunta sobre el rol",
        "Despedida casual pero profesional"
      ],
      "tone": "Amigable, genuino, entusiasta",
      "length_words": 180,
      "example_opening": "Hola [nombre],\n\nVi la oferta para [puesto] en [empresa] y no pude evitar aplicar..."
    }
  },

