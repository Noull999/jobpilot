# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/jobpilot

# Claude API (for ApplyPilot + LiteLLM)
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Gemini API (Free tier fallback)
GEMINI_API_KEY=your-gemini-api-key-here

# ApplyPilot Configuration
APPLYPILOT_ENABLED=true
APPLYPILOT_PRIMARY_LLM=claude-opus  # Primary model: claude-opus or gemini
APPLYPILOT_FALLBACK_LLM=gemini      # Fallback model
LITELLM_PROXY_URL=http://localhost:4000

# Stripe Keys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production-32-chars-min

# JWT Configuration (MUST BE DIFFERENT FROM SECRET_KEY)
JWT_SECRET_KEY=your-jwt-secret-key-here-different-32-chars-min

# CORS (Dominios permitidos, separados por comas)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://jobpilot.com

# Security
JWT_ACCESS_TOKEN_EXPIRES=15  # Minutos
JWT_REFRESH_TOKEN_EXPIRES=30  # Días

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=joseestebanasencio@gmail.com
MAIL_PASSWORD=your-app-password  # Use Gmail App Password, not account password
MAIL_DEFAULT_SENDER=noreply@jobpilot.ai

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Server Configuration
PORT=5000
DEBUG=False  # Cambiar a False en producción
LOG_LEVEL=INFO
