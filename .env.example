# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/jobpilot

# Claude API
CLAUDE_API_KEY=sk-ant-YOUR_KEY_HERE

# Stripe Keys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
